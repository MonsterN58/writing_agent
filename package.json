{
  "name": "moshu-agent",
  "version": "0.1.0",
  "private": true,
  "description": "墨枢 Agent · 本地优先的网文写作 Agent",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build:css": "node scripts/build-styles.mjs",
    "build": "node scripts/build-styles.mjs && vite build",
    "preview": "vite preview",
    "eval": "node evals/runner.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "js-yaml": "^4.1.1",
    "marked": "^14.1.3",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
